{
  "name": "@next-secure-check/rules",
  "version": "0.5.0",
  "description": "Security rules for next-secure-check",
  "keywords": [
    "nextjs",
    "security",
    "scanner",
    "static-analysis",
    "sast"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/SetraTheXX/next-secure-check.git"
  },
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "dependencies": {
    "@next-secure-check/core": "workspace:*",
    "typescript": "^5.9.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true});fs.rmSync('.tsbuildinfo',{force:true})\""
  }
}
